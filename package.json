{
  "name": "developer-handbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sổ tay kỹ thuật thực hành bằng tiếng Việt, có tìm kiếm và sử dụng VitePress.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1",
    "build": "npm run check && vitepress build docs",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "docs:dev": "npm run dev",
    "docs:build": "npm run build",
    "docs:preview": "npm run preview",
    "check": "node scripts/check-docs.mjs",
    "verify": "node scripts/verify-site.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vue": "3.5.45",
    "typescript": "5.7.3",
    "vue-tsc": "3.3.14",
    "@types/node": "22.10.5"
  },
  "overrides": {
    "vite": "6.4.5"
  }
}
